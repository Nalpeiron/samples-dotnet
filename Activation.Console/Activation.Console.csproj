<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="11.9.0" />
      <PackageReference Include="IdentityModel.OidcClient.IdentityTokenValidator" Version="6.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.13" />
      <PackageReference Include="Sharprompt" Version="2.4.5" />
      <PackageReference Include="Spectre.Console.Json" Version="0.49.1" />
      <PackageReference Include="Zentitle.Licensing.Client" Version="3.5.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Zentitle2CoreLibPlaceholder\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
